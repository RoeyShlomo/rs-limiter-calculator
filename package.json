{
  "name": "rs-limiter-calculator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "RS Limiter Calculator - Professional Audio System Design & Calibration by Roey Shlomo",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview",
